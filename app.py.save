# ============================================================
# MODEL FINDER
# ============================================================

@st.cache_resource
def find_model():

    possible_extensions = [
        "*.h5",
        "*.keras",
        "*.hdf5"
    ]

    model_files = []

    for extension in possible_extensions:
        model_files.extend(
            glob.glob(
                os.path.join(
                    os.getcwd(),
                    "**",
                    extension
                ),
                recursive=True
            )
        )

    if not model_files:
        return None, None

    # Prefer common model names
    preferred = [
        "blood_group_model.h5",
        "model.h5",
        "cnn_model.h5",
        "fingerblood_model.h5",
        "blood_model.h5"
    ]

    for name in preferred:

        for path in model_files:

            if os.path.basename(path).lower() == name.lower():
                return tf.keras.models.load_model(path), path

    # Otherwise use first model found
    model_path = model_files[0]

    model = tf.keras.models.load_model(model_path)

    return model, model_path


# ============================================================
# LOAD MODEL
# ============================================================

try:

    model, model_path = find_model()

except Exception as e:

    model = None
    model_path = None

# ============================================================
# CLASS NAMES
# ============================================================

CLASS_NAMES = [
    "A+",
    "A-",
    "AB+",
    "AB-",
    "B+",
    "B-",
    "O+",
    "O-"
]


# ============================================================
# IMAGE PREPROCESSING
# ============================================================

def preprocess_image(image):

    # Convert to grayscale
    image = image.convert("L")

    # Resize to model size
    image = image.resize((128, 128))

    # Convert to numpy
    image_array = np.array(image)

    # Normalize
    image_array = image_array.astype("float32") / 255.0

    # Check model input shape
    if model is not None:

        input_shape = model.input_shape

        # Example:
        # (None, 128, 128)
        if len(input_shape) == 3:
            image_array = np.expand_dims(
                image_array,
                axis=0
            )

        # Example:
        # (None, 128, 128, 1)
        elif len(input_shape) == 4:
            image_array = np.expand_dims(
                image_array,
                axis=-1
            )

            image_array = np.expand_dims(
                image_array,
                axis=0
            )

        else:
            image_array = np.expand_dims(
                image_array,
                axis=0
            )

    return image_array


# ============================================================
# PREDICTION
# ============================================================

def predict_blood_group(image):

    processed = preprocess_image(image)

    predictions = model.predict(
        processed,
        verbose=0
    )

    probabilities = predictions[0]

    predicted_index = np.argmax(probabilities)

    predicted_class = CLASS_NAMES[predicted_index]

    confidence = probabilities[predicted_index] * 100

    return predicted_class, confidence, probabilities


