# ============================================================
# PREDICTION SECTION
# ============================================================

if uploaded_file is not None:

    image = Image.open(uploaded_file)

    st.markdown(
        '<div class="section-title">🖼️ Uploaded Fingerprint</div>',
        unsafe_allow_html=True
    )

    image_col, result_col = st.columns(
        [1, 1],
        gap="large"
    )

    # --------------------------------------------------------
    # IMAGE
    # --------------------------------------------------------

    with image_col:

        st.image(
            image,
            caption="Uploaded Fingerprint",
            use_container_width=True
        )

    # --------------------------------------------------------
    # PREDICTION
    # --------------------------------------------------------

    with result_col:

        with st.spinner("Analyzing fingerprint..."):

            try:

                predicted_class, confidence, probabilities = \
                    predict_blood_group(image)

                st.markdown(f"""
                <div class="result-card">

                    <div class="result-label">
                        PREDICTED BLOOD GROUP
                    </div>

                    <div class="blood-group">
                        {predicted_class}
                    </div>

                    <div class="confidence">
                        Model Confidence:
                        <b>{confidence:.2f}%</b>
                    </div>

                </div>
                """, unsafe_allow_html=True)

            except Exception as e:

                st.error(
                    f"Prediction failed: {str(e)}"
                )

                st.stop()


    # ========================================================
    # PROBABILITY DISTRIBUTION
    # ========================================================

    st.markdown(
        '<div class="section-title">📈 Prediction Probabilities</div>',
        unsafe_allow_html=True
    )

    probability_dict = {
        CLASS_NAMES[i]: float(probabilities[i]) * 100
        for i in range(len(CLASS_NAMES))
    }

    # Sort highest to lowest
    sorted_probabilities = dict(
        sorted(
            probability_dict.items(),
            key=lambda x: x[1],
            reverse=True
        )
    )

    st.bar_chart(
        sorted_probabilities,
        horizontal=True
    )

    # Detailed probability table

    st.markdown(
        '<div class="section-title">🔎 Detailed Results</div>',
        unsafe_allow_html=True
    )

    for blood_group, probability in sorted_probabilities.items():

        col_a, col_b = st.columns(
            [1, 5]
        )

        with col_a:

            st.write(
                f"**{blood_group}**"
            )

        with col_b:

            st.progress(
                min(
                    probability / 100,                    1.0
                )
            )

            st.caption(
                f"{probability:.2f}%"
            )


